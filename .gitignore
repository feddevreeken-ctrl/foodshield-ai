# ============================================================================
#  FoodShield AI — .gitignore
#  Goal: only the shippable web app goes to GitHub. All proprietary knowledge,
#  internal docs, skills, backups, and dev artifacts stay LOCAL.
# ============================================================================

# ── OS / editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.tmp
*.bak
~$*
.~lock.*#
lu*.tmp
.w1ref.tmp.json
main

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.*
!.env.example

# ── Data backups & internal working files (the app only needs the clean *.json)
data/*.bak_*
data/*.json.bak*
data/*.rebuilt.json
data/_*            # _fao_bilateral_results.txt, _fdrs_baseline.json, _*_worklist.json, etc.
data/trade_rebuild_priorities.json

# ── YOUR SKILLS & KNOWLEDGE (never publish — this is the IP you want protected)
skills/
*.skill
.claude/

# ── Legacy + version backups (history lives in git; no need to ship copies) ──
legacy/
foodshield-v*.html
foodshield-v*.html.bak
foodshield-mobile-preview.html
.archive_index_bak_*.html
v2-part1-shell.html
.w1ref.tmp.json

# ── Internal tooling / security notes / dev mirrors (not part of the app) ───
SECURITY_AND_PUBLISH.md
cleanup_and_secure.command
foodshield-v21.html
foodshield-mobile-preview.html

# ── Internal / strategic docs (specs, audits, handovers, decks) ─────────────
#   Keep these private. The app does not need them at runtime.
archive/
AUDIT_FIXES_*.md
BASELINE_REVERIFICATION_SPEC.md
CORE_PROJECT_AUDIT_*.md
DATA_RELIABILITY_PLAN.md
DATA_SOURCES_ROADMAP.md
DECISIONS.md
DEMO_SCRIPT.md
DOCUMENTATION_AUDIT_*.docx
FDRS_*.md
FIELD_LINEAGE_MAP.md
FOODSHIELD_AI_WORKFLOW_GUIDE.md
HANDOFF_*.md
HANDOVER_*.md
INDEX.md
LINKEDIN_POST_DRAFT.md
NOWCAST_V2_DESIGN.md
PROJECT_HANDOFF_FOR_AI.md
SCENARIO_*_AUDIT_*.md
START_HERE.md
TRADE_SCHEMA_REMEDIATION_PLAN.md
UI_PROVENANCE_SPEC.md
V23_CHANGELOG.md
COMMODITY_FLOWS_DESIGN.md
COMPANY_DATA_SOURCES_RESEARCH.md
AI_TRADE_FLOW_RELIABILITY_GUIDE.md
*_RESEARCH_NOTES.md
reverify_worklist.*
TRADE_REBUILD_PRIORITY_REPORT.md

# ── Decks / briefs / blueprints (private business material) ─────────────────
*.docx
*.pptx
FoodShield_AI_Technical_Brief.pdf
FoodShield_Rabobank_Deck.pdf
"claude check.docx"

# ── Local docs/assets tree (reorganized 2026-06-28 — internal, never ship) ──
#   Individual files are already pattern-ignored above; these folder rules make
#   the whole reorganized tree local so `git add -A` can't publish it.
docs/
assets/

# ── Stale Next.js scaffold (the single-file index.html is the real app) ─────
foodshield/

# ── QA screenshots / scratch images (optional internal) ─────────────────────
qa-*.jpg
qa2-*.jpg
slide-*.jpg

# ============================================================================
#  WHAT STILL GETS PUBLISHED (intentionally NOT ignored):
#    index.html            — the app
#    data/*.json           — the live data the app fetches
#    og-image.png          — social preview
#    scripts/              — the open data-refresh pipeline (no secrets; uses env vars)
#    vercel.json, robots.txt, sitemap.xml, requirements.txt
#    README.md, SETUP.md, CHANGELOG.md — public-facing docs (keep if you want)
# ============================================================================

# Generated exposure-brief PDFs (produced on demand by scripts/generate_exposure_brief.py)
briefs/
