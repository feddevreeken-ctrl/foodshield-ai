# What ships to Vercel. Git keeps everything; the deployment gets only what the site
# serves or builds from. Allowlist first, then the exceptions inside data/.
/*
!/index.html
!/middleware.js
!/seo.json
!/api
!/js
!/data
!/img
!/.well-known
!/og-image.png
!/robots.txt
!/sitemap.xml
!/llms.txt
!/package.json
!/package-lock.json
!/vercel.json

# data/ files the page never fetches (build inputs, archives, notes).
# data/tm/* and data/sst_winters/* ARE fetched (by ISO code / winter label): keep them.
# data/ref holds build inputs, except the two files the page fetches (access lines, crop-area weights).
/data/ref/*
!/data/ref/access_thresholds.json
!/data/ref/crop_area_2p5.json.gz
/data/.archive*
/data/comtrade_exports.json
/data/reverify_records.json
/data/acled.json
/data/fx_rates.json
/data/faostat_import_dep.json
/data/country_caloric_shares.json
/data/hapi_idps.json
/data/nasa_firms.json
/data/scenario_spec.json
/data/wfp_hungermap.json
/data/companies
/data/**/README.md
**/*.md
**/*.bak
**/.DS_Store
