   "scenarios": [
    {
     "id": "us_corn_belt_drought",
     "label": "US Corn Belt drought cuts exports 20%",
     "shockIso": "USA",
     "severity": 0.2,
     "note": "The US supplies ~30% of world corn exports (~72 Mt); a Midwest drought like 2012 can cut the crop ~15-25% and sharply tighten exportable supply, hitting Mexico, Japan, Colombia and Korea hardest.",
     "src": "usdaPSDcorn"
    },
    {
     "id": "brazil_safrinha_failure",
     "label": "Brazil safrinha failure cuts exports 30%",
     "shockIso": "BRA",
     "severity": 0.3,
     "note": "Over 75% of Brazil's crop is the weather-exposed safrinha second corn; a dry/hot window (as in 2021) can slash output and the ~40 Mt export program, raising prices for China, Egypt, Vietnam and Iran.",
     "src": "usdaPSDcorn"
    },
    {
     "id": "ukraine_black_sea_disruption",
     "label": "Ukraine Black Sea corridor disruption -50%",
     "shockIso": "UKR",
     "severity": 0.5,
     "note": "Ukraine exports ~22 Mt of corn, roughly half to the EU; renewed Black Sea blockade or escalation could halve flows, as in 2022. The EU, China, Egypt and Turkey would scramble for substitutes.",
     "src": "igc"
    },
    {
     "id": "argentina_export_tax",
     "label": "Argentina raises corn export taxes/curbs -40%",
     "shockIso": "ARG",
     "severity": 0.4,
     "note": "Argentina has repeatedly used export taxes (retenciones) and registration limits on grains; a tightening would pull ~14 Mt off the world market, lifting prices for SE Asia, Algeria, Saudi Arabia and Peru.",
     "src": "usdaPSDcorn"
    },
    {
     "id": "china_demand_surge",
     "label": "China corn import surge (herd rebuild) +15 Mt",
     "shockIso": "CHN",
     "severity": 0.3,
     "note": "China's corn imports swing widely (from ~23 Mt in 2023/24 to ~8 Mt in 2024/25). A hog-herd rebuild or poor domestic harvest could add 10-15 Mt of import demand, tightening Brazilian, Ukrainian and US balances.",
     "src": "usdaGrain"
    },
    {
     "id": "southern_africa_drought",
     "label": "Southern Africa El Nino drought (regional deficit)",
     "shockIso": "ZAF",
     "severity": 0.35,
     "note": "El Nino droughts (as in 2024) cut South Africa's ~13 Mt crop and devastate Zimbabwe/Zambia/Malawi white-maize harvests, forcing large emergency imports and spiking regional food prices.",
     "src": "usdaPSDcorn"
    }
   ]
  },
