     "id": "brazil_drought",
     "label": "Brazil drought cuts the crop ~20%",
     "shockIso": "BRA",
     "severity": 0.2,
     "note": "Brazil is ~37% of world output and ~60% of world bean exports; a La Nina / Cerrado-Matopiba drought of the 2021/22 type can cut the crop 15-25%, spiking China's import bill and global prices.",
     "src": "usdaOilseeds"
    },
    {
     "id": "us_china_trade_war",
     "label": "US-China tariff war zeroes US beans to China",
     "shockIso": "USA",
     "severity": 0.5,
     "note": "China bought ~22-27 Mt of US beans in 2024 (~half of US exports); a tariff/retaliation freeze (as seen late-2025) redirects US beans to the EU/Mexico/SE Asia at a discount and hands China share to Brazil. Models a ~50% hit to US export demand.",
     "src": "ussec"
    },
    {
     "id": "argentina_crush_disruption",
     "label": "Argentina crush/export-tax disruption",
     "shockIso": "ARG",
     "severity": 0.3,
     "note": "Argentina is the world's #1 soymeal & soyoil exporter (~40 Mt crush). A strike, drought, or export-tax/peso shock cutting crush ~30% tightens global meal supply and raises feed costs worldwide.",
     "src": "usdaOilseeds"
    },
    {
     "id": "china_demand_drop",
     "label": "China demand falls ~15% (herd/biofuel shift)",
     "shockIso": "CHN",
     "severity": 0.15,
     "note": "China is ~60% of world bean imports; an African Swine Fever hog-herd contraction or a shift in crush/meal-inclusion policy cutting imports ~15% would slash Brazilian and US export demand and global prices.",
     "src": "usdaOilseeds"
    },
    {
     "id": "parana_logistics",
     "label": "Parana/Mississippi low-water logistics shock",
     "shockIso": "BRA",
     "severity": 0.1,
     "note": "Low water on the Parana-Paraguay waterway (Paraguay/Argentina beans) or the Mississippi (US Gulf exports) repeatedly raises freight and strands ~10% of exportable supply for a season (USDA AMS transport reports).",
     "src": "usdaOilseeds"
    },
    {
     "id": "eudr_deforestation",
     "label": "EUDR tightening reshapes Brazil-EU soy",
     "shockIso": "BRA",
     "severity": 0.1,
     "note": "The EU Deforestation Regulation requires deforestation-free traceability; partial non-compliance could cut ~10% of Brazil's ~5 Mt of beans to the EU, redirecting it to China and lifting demand for certified Canadian/Ukrainian beans.",
     "src": "usdaOilseeds"
    }
   ]
  },
