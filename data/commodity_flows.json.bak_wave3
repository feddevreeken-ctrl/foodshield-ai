   "companies": [
    {
     "name": "Cargill",
     "hq": "United States",
     "iso": "USA",
     "src": "wtex",
     "flag": "modeled",
     "metric": "Group revenue ≈US$160bn (FY2024); operates in ~70 countries; one of the 'ABCD' grain majors.",
     "sourcing": [
      "USA",
      "BRA",
      "ARG",
      "UKR",
      "FRA",
      "RUS"
     ],
     "note": "World's largest privately held company and a top global grain/oilseed trader; major corn origination and export elevation in the US Gulf, Brazil and the Black Sea.",
     "improve": "As a private company under no SEC-filing pressure, Cargill discloses little segment-level corn volume or origin data. It should publish corn-specific origination by country and freight-route, plus traceability for Cerrado-origin feed grain, so customers and regulators can size land-use and concentration risk."
    },
    {
     "name": "Archer-Daniels-Midland (ADM)",
     "hq": "United States",
     "iso": "USA",
     "src": "adm",
     "flag": "sourced",
     "metric": "Revenue ≈US$85bn (FY2024); Ag Services & Oilseeds is its largest segment; major US corn processor (wet milling, ethanol, sweeteners).",
     "sourcing": [
      "USA",
      "BRA",
      "ARG",
      "UKR"
     ],
     "note": "Leading US corn processor and global merchandiser; large ethanol, starch and sweetener operations consume domestic corn, plus an international grain trading book.",
     "improve": "ADM's corn footprint spans origination, processing and ethanol, but its disclosures blend corn into 'Ag Services'. Breaking out corn origination volume by country and the deforestation/land-use exposure of its South American sourcing would let the market price feedstock and policy risk."
    },
    {
     "name": "Bunge Global (Bunge-Viterra)",
     "hq": "United States / Switzerland",
     "iso": "USA",
     "src": "bunge",
     "flag": "sourced",
     "metric": "Revenue ≈US$53bn (FY2024); 2024-25 merger with Viterra creates a top-tier global grain/oilseed handler.",
     "sourcing": [
      "BRA",
      "ARG",
      "USA",
      "UKR",
      "CAN",
      "AUS"
     ],
     "note": "A core 'ABCD' trader with deep South American (Brazil/Argentina) origination; the Viterra combination adds Black Sea, Canadian and Australian reach in corn and other grains.",
     "improve": "Post-Viterra, Bunge becomes one of the largest corn handlers in the Americas and Black Sea. It should publish combined corn origination by country and concentration metrics, and detail how the enlarged network manages Mercosur land-use and Black Sea war-risk exposure."
    },
    {
     "name": "Louis Dreyfus Company (LDC)",
     "hq": "Netherlands / France",
     "iso": "NLD",
     "src": "ldc",
     "flag": "sourced",
