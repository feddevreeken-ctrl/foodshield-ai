     "name": "KRBL Limited (India Gate basmati)",
     "hq": "India",
     "iso": "IND",
     "src": "krbl",
     "flag": "sourced",
     "metric": "World's largest basmati rice miller/exporter by brand; flagship India Gate; exports to >90 countries (Gulf, US, EU).",
