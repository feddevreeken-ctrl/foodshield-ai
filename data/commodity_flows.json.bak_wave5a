   "scenarios": [
    {
     "id": "india_export_ban",
     "label": "India re-imposes a non-basmati white-rice export ban",
     "shockIso": "IND",
     "severity": 0.45,
     "note": "Modeled on the actual Jul-2023 to Sep-2024 ban: Indian shipments fell ~one-third (from 21.3 Mt to 14.3 Mt Sep23-Aug24, non-basmati white rice down ~87%) and the Thai 5% price rose ~20%. Africa, Bangladesh and SE Asia are hit hardest; India is ~40% of world trade so a partial ban removes the largest swing supplier.",
     "src": "usdaERS"
    },
    {
     "id": "elnino_asia_harvest",
     "label": "El Niño cuts SE-Asian harvests, Indonesia/Philippines import surge",
     "shockIso": "IDN",
     "severity": 0.3,
     "note": "The 2023-24 El Niño drove Indonesia's 2024 imports to a record ~4.52 Mt and the Philippines to ~4.7 Mt. A repeat tightens exportable supply from Thailand/Vietnam and lifts prices for all import-dependent buyers.",
     "src": "usda"
    },
    {
     "id": "vietnam_export_curb",
     "label": "Vietnam restricts exports to protect domestic supply",
     "shockIso": "VNM",
     "severity": 0.25,
     "note": "Vietnam has briefly suspended/limited rice export contracts before (e.g. 2020). As the Philippines' ~80% supplier and #2 world exporter, even a temporary Vietnamese curb leaves Manila acutely exposed.",
     "src": "usda"
    },
    {
     "id": "basmati_gulf_disruption",
     "label": "Gulf shipping/sanctions disruption hits India-Pakistan basmati to MENA",
     "shockIso": "IND",
     "severity": 0.2,
     "note": "~80% of India's basmati goes to the Middle East (Saudi Arabia now #1, plus Iran, Iraq, UAE). Red Sea/Strait-of-Hormuz disruption or Iran sanctions/payment friction has already curbed basmati flows; models a hit to the premium export trade.",
     "src": "apeda"
    },
    {
     "id": "thailand_drought",
     "label": "Thai drought cuts exportable rice ~20%",
     "shockIso": "THA",
     "severity": 0.2,
     "note": "Thailand's irrigated-area and reservoir swings move exportable supply ~15-25% between years. As the #2 exporter and Africa's record 2024 supplier (~3 Mt), a Thai shortfall raises West-African and MENA import costs.",
     "src": "usda"
    },
    {
     "id": "pakistan_flood",
     "label": "Pakistan flood destroys rice crop (2022-style)",
     "shockIso": "PAK",
     "severity": 0.35,
     "note": "The 2022 floods cut Pakistan's rice output sharply and slashed exports. As the swing supplier that absorbed India-ban demand (Gulf basmati, African/SE-Asian non-basmati), a Pakistani shortfall removes the main alternative to India.",
     "src": "usda"
    }
   ]
  },
