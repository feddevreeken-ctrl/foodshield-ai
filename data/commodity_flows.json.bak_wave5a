   "companies": [
    {
     "name": "JBS S.A.",
     "hq": "Brazil",
     "iso": "BRA",
     "src": "jbs",
     "flag": "sourced",
     "metric": "Net revenue ≈ US$77bn (FY2024); ~24% of sales are exports.",
     "sourcing": [
      "BRA",
      "AUS",
      "USA",
      "ARG",
      "PRY",
      "URY",
      "CAN"
     ],
     "note": "World's largest meat company. Beef plants in Brazil, US, Australia, Canada, and across South America.",
     "improve": "As the largest buyer of Brazilian cattle, JBS's biggest gap is farm-level deforestation traceability — its indirect-supplier monitoring and EUDR readiness need a clear, audited rollout. It should publish per-region sourcing and Scope-3 emissions intensity (Brazil vs. US vs. Australia) so investors can size its climate/deforestation exposure rather than infer it."
    },
    {
     "name": "Marfrig Global Foods",
     "hq": "Brazil",
     "iso": "BRA",
     "src": "marfrig",
     "flag": "sourced",
     "metric": "Revenue split ≈43% US, 24% Brazil, 20% Asia (FY2024).",
     "sourcing": [
      "BRA",
      "USA",
      "ARG",
      "URY",
      "CHL"
     ],
     "note": "Owns National Beef (US); merging with BRF. Strong North & South America footprint.",
     "improve": "With a large share of cattle from Brazil, Marfrig should disclose state/biome-level sourcing and publish a concrete EUDR traceability roadmap (peers are ahead on digital verification). Its ESG reports aggregate too much — per-country GHG and deforestation-linked sourcing data would let the market price its exposure."
    },
    {
     "name": "Minerva Foods",
     "hq": "Brazil",
     "iso": "BRA",
     "src": "minerva",
     "flag": "sourced",
     "metric": "South America's largest beef exporter; ~21% of S. American beef export share.",
     "sourcing": [
      "BRA",
      "ARG",
      "URY",
      "PRY",
      "COL",
      "AUS"
     ],
     "note": "46 industrial units across Brazil, Argentina, Uruguay, Paraguay, Colombia, Chile, Australia.",
     "improve": "Heavily South-America-concentrated with no US slaughter base, Minerva carries currency, tariff and single-region risk. It should quantify the coverage and audit frequency of its 'Full Traceable' program, publish per-source carbon intensity, and diversify customers beyond export markets to cushion South American volatility."
    },
    {
     "name": "Tyson Foods",
     "hq": "United States",
     "iso": "USA",
     "src": "tyson",
     "flag": "sourced",
     "metric": "Beef ≈ a fifth-plus of ~US$53bn revenue (FY2024); beef segment under margin pressure.",
     "sourcing": [
      "USA",
      "CAN",
      "MEX",
      "AUS"
     ],
     "note": "Largest US beef processor by capacity; predominantly domestic US cattle.",
     "improve": "Tyson's US-centric footprint leaves it exposed to the domestic cattle-cycle squeeze and regional trade shifts. It should disclose feed-sourcing (Amazon/Cerrado soy) deforestation exposure, break out per-region Scope-3 intensity, and build export capacity to diversify a beef segment that is losing share to poultry."
    },
    {
     "name": "Cargill",
     "hq": "United States",
     "iso": "USA",
     "src": "cargill",
     "flag": "modeled",
     "metric": "Group revenue ≈US$160bn (FY2024); operates in ~70 countries; beef a minority segment.",
     "sourcing": [
      "USA",
      "CAN",
      "AUS",
      "BRA",
      "ARG"
     ],
     "note": "Major North American processor; private company, limited per-country beef sourcing disclosure.",
     "improve": "As a private company under no SEC-filing pressure, Cargill's disclosure lags listed peers — it should voluntarily publish beef-specific sourcing geography, emissions intensity, and an EUDR-compliance roadmap. Its beef segment risks being under-resourced on traceability relative to its core grain/feed businesses."
    },
    {
     "name": "NH Foods (Nippon Ham)",
     "hq": "Japan",
     "iso": "JPN",
     "src": "nhfoods",
     "flag": "sourced",
     "metric": "Net sales ≈¥1.8tn (~US$12-13bn, FY2024); beef ~10-12% of portfolio; ops in ~19 countries.",
     "sourcing": [
      "AUS",
      "USA",
      "JPN",
      "URY"
     ],
     "note": "Japan's leading meat group; large Australian beef operations (Oakey, Whyalla).",
     "improve": "With ~80% of its beef imported and Australia a dominant single source, NH Foods carries concentration and supply-disruption risk. It should diversify origin beyond Australia/US, strengthen farm-level traceability of imported cattle, and expand English-language ESG/Scope-3 disclosure so global investors can assess origin-level risk."
    }
