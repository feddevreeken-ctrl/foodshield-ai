   "scenarios": [
    {
     "id": "black_sea_disruption",
     "label": "Black Sea export disruption (Russia + Ukraine ports)",
     "shockIso": "RUS",
     "severity": 0.35,
     "note": "Russia (~44 Mt) and Ukraine (~16 Mt) together supply ~30% of world wheat trade. A renewed corridor breakdown, port strike or escalation could cut Black Sea exportable supply ~30-40%, hitting Egypt, Turkey, Bangladesh and sub-Saharan importers hardest (USDA/IGC).",
     "src": "usdaPSD"
    },
    {
     "id": "russia_export_curb",
     "label": "Russia tightens wheat export quota/tax 25%",
     "shockIso": "RUS",
     "severity": 0.25,
     "note": "Russia routinely uses export quotas and floating duties to manage domestic prices; a tightening of ~25% would squeeze its biggest customers Egypt (8 Mt) and Turkey, forcing them toward pricier EU/US origins (Rusagrotrans/USDA).",
     "src": "rusagrotrans"
    },
    {
     "id": "australia_drought",
     "label": "Australian drought cuts exports 25%",
     "shockIso": "AUS",
     "severity": 0.25,
     "note": "Australian wheat output swings widely with ENSO; an El Niño drought can cut the ~23.5 Mt export program 20-30%, raising prices for Indonesia, the Philippines and Vietnam that depend on Australian milling wheat (USDA/ABARES).",
     "src": "usdaPSD"
    },
    {
     "id": "india_export_ban",
     "label": "India keeps export ban / global tightness",
     "shockIso": "IND",
     "severity": 0.2,
     "note": "India is the #2 producer (~113 Mt) but has banned exports since May 2022. A continued ban plus a poor monsoon keeps ~10 Mt of potential supply off the market and could even turn India into an importer, tightening Asian balances (USDA).",
     "src": "usdaPSD"
    },
    {
     "id": "eu_harvest_failure",
     "label": "EU wet-weather harvest failure (France-led)",
     "shockIso": "EU",
     "severity": 0.3,
     "note": "The wet 2024 French harvest already cut EU soft-wheat exports ~35%. A repeat would remove milling wheat that Morocco, Algeria and Nigeria rely on, pushing them onto Black Sea and forcing quality substitution (EU Commission/USDA).",
     "src": "usdaPSD"
    },
    {
     "id": "argentina_export_tax",
     "label": "Argentina reimposes wheat export taxes 30%",
     "shockIso": "ARG",
     "severity": 0.3,
     "note": "Argentina has repeatedly used export taxes (retenciones) to curb domestic food prices; a 30% disincentive would cut shipments to Brazil — which takes ~6 Mt via tariff-free Mercosur — and push Brazil toward US/Black Sea wheat at higher cost (USDA/ITC).",
     "src": "usdaPSD"
    }
   ]
