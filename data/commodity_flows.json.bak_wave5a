   "companies": [
    {
     "name": "Cargill",
     "hq": "United States",
     "iso": "USA",
     "src": "cargill",
     "flag": "sourced",
     "metric": "Revenue ~US$160-177bn (FY2024); privately held, one of the largest grain traders.",
     "sourcing": [
      "USA",
      "CAN",
      "ARG",
      "AUS",
      "UKR",
      "RUS",
      "FRA",
      "ROU"
     ],
     "note": "Member of the 'ABCD' majors that handle the bulk of internationally traded grain. Global origination across North & South America, Black Sea and the EU; large port and elevator network.",
     "improve": "Cargill is privately held and discloses little segment-level wheat volume or origin detail. Publishing audited per-origin tonnage and Black Sea exposure would let buyers and analysts size concentration risk rather than infer it."
    },
    {
     "name": "Archer Daniels Midland (ADM)",
     "hq": "United States",
     "iso": "USA",
     "src": "adm",
     "flag": "sourced",
     "metric": "Revenue ~US$85bn (FY2024); Ag Services & Oilseeds is the core grain-handling segment.",
     "sourcing": [
      "USA",
      "CAN",
      "ARG",
      "UKR",
      "FRA",
      "ROU",
      "AUS"
     ],
     "note": "One of the 'ABCD' majors. Large North American and Black Sea origination, milling and logistics footprint.",
     "improve": "ADM should break out wheat (vs. corn/soy) origination volumes by region and disclose Black Sea sourcing exposure, which is currently bundled inside Ag Services."
    },
    {
     "name": "Bunge Global (Bunge–Viterra)",
     "hq": "United States/Switzerland",
     "iso": "USA",
     "src": "bunge",
     "flag": "sourced",
     "metric": "Revenue ~US$53bn (Bunge FY2024); the ~US$34bn Bunge–Viterra merger completed July 2025 created a top-tier grain trader.",
     "sourcing": [
      "USA",
      "CAN",
      "ARG",
      "AUS",
      "UKR",
      "RUS",
      "FRA"
     ],
     "note": "Post-merger Bunge-Viterra is one of the largest global grain handlers, with deep Canadian (Viterra Prairie elevators), Australian and Black Sea origination added to Bunge's Americas base.",
     "improve": "Integration of Viterra's Canadian/Australian assets concentrates a large share of Prairie and Black Sea wheat handling in one firm; transparent post-merger origin-share reporting would address competition and concentration concerns."
    },
    {
     "name": "Louis Dreyfus Company (LDC)",
     "hq": "Netherlands/France",
     "iso": "NLD",
     "src": "ldc",
     "flag": "sourced",
     "metric": "Revenue ~US$50bn (FY2024); the 'D' in ABCD, with a Grains & Oilseeds platform.",
     "sourcing": [
      "ARG",
      "USA",
      "CAN",
      "AUS",
      "UKR",
      "RUS",
      "FRA"
     ],
     "note": "Major Black Sea, South American and EU wheat originator; acquired Viterra divestiture assets in the EU as a remedy to the Bunge-Viterra merger.",
     "improve": "Privately held; LDC discloses limited per-commodity origin data. Region-level wheat tonnage disclosure would improve traceability of its Black Sea and South American flows."
    },
