     "name": "COFCO International",
     "hq": "China/Switzerland",
     "iso": "CHN",
     "src": "cofco",
     "flag": "sourced",
     "metric": "Agribusiness revenue rivals the ABCD majors; China's state-linked global grain trader.",
     "sourcing": [
