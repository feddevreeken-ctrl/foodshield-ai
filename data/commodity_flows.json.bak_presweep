      "companies": [
        {
          "name": "Olam Agri",
          "hq": "Singapore",
          "iso": "SGP",
          "src": "olam",
          "flag": "sourced",
          "metric": "Trades >40 Mt of agri commodities/yr; one of the largest global rice merchandisers; secured US$100m (2025) to expand Africa rice shipments.",
          "sourcing": [
            "IND",
            "THA",
            "VNM",
            "PAK",
            "MMR",
            "USA"
          ],
          "note": "Major originator and shipper of rice into Africa and the Middle East; origination hubs in Nigeria, Vietnam and Thailand. Olam announced a 2024 combination with Louis Dreyfus's rice business, pooling origination.",
          "improve": "Should publish origin-split rice volumes and the share of parboiled vs white vs fragrant it moves, so its exposure to an India-style export ban can be sized rather than inferred."
        },
        {
          "name": "Louis Dreyfus Company (LDC)",
          "hq": "Netherlands/Switzerland",
          "iso": "NLD",
          "src": "ldc",
          "flag": "sourced",
          "metric": "One of the ABCD majors; dedicated global Rice platform (merchandising + milling). 2024 Olam-LDC rice combination created a ~US$40bn-revenue origination platform.",
          "sourcing": [
            "IND",
            "THA",
            "VNM",
            "USA",
            "BRA",
            "ARG",
            "URY"
          ],
          "note": "Long-standing global rice merchandiser with milling and origination across Asia and the Americas; supplies Africa, the Middle East and the EU.",
          "improve": "Rice-segment volumes are not broken out in group reporting; disclosing origin and destination concentration would let food-security analysts model supplier-shock exposure."
        },
        {
          "name": "ITC Limited (Agri Business)",
          "hq": "India",
          "iso": "IND",
          "src": "itcltd",
          "flag": "sourced",
          "metric": "~9.8% share of India's rice exports (Feb 2025); supplies basmati & non-basmati to the Gulf, US, SE Asia and EU.",
          "sourcing": [
            "IND"
          ],
          "note": "India's largest single rice exporter by share; sources paddy across Indian states and ships premium basmati and bulk non-basmati. Directly exposed to India's export-policy switches.",
          "improve": "Concentration in a single origin (India) makes ITC's rice book highly sensitive to New Delhi's ban/MEP/duty changes — it should disclose how it hedges policy risk."
        },
        {
          "name": "KRBL Limited (India Gate basmati)",
          "hq": "India",
          "iso": "IND",
          "src": "krbl",
          "flag": "sourced",
          "metric": "World's largest basmati rice miller/exporter by brand; flagship India Gate; exports to >90 countries (Gulf, US, EU).",
          "sourcing": [
            "IND"
          ],
          "note": "Dominant branded basmati exporter; the Gulf (Saudi Arabia, UAE, Iran) is its core market — directly exposed to India's basmati MEP and to Gulf demand swings.",
          "improve": "Should disclose destination-market concentration (Gulf share) and basmati MEP sensitivity for investors sizing geopolitical/policy risk."
        },
        {
          "name": "Phoenix Group (Pakistan)",
          "hq": "Pakistan",
          "iso": "PAK",
